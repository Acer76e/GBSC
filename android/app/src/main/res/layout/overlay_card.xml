<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:minWidth="180dp">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_fare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/card_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="$0.00" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textColor="@color/card_subtext"
            android:textSize="18sp"
            android:text="×" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_metrics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <LinearLayout
            android:id="@+id/block_mi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="10dp">
            <View
                android:id="@+id/bar_mi"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:background="@color/grade_good" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_mi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="0.00" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_subtext"
                    android:textSize="10sp"
                    android:text="$/mi" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="10dp">
            <View
                android:id="@+id/bar_hr"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:background="@color/grade_good" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_hr_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="0.00" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_subtext"
                    android:textSize="10sp"
                    android:text="$/hr" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="10dp">
            <View
                android:id="@+id/bar_min"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:background="@color/grade_good" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_min_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="0.00" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_subtext"
                    android:textSize="10sp"
                    android:text="$/min" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View
                android:id="@+id/bar_rating"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:background="@color/grade_avg" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="0.0" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/card_subtext"
                    android:textSize="10sp"
                    android:text="rating" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_trip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/card_subtext"
        android:textSize="12sp"
        android:text="0h00m · 0mi" />

    <TextView
        android:id="@+id/tv_profit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/grade_good"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="" />

</LinearLayout>
